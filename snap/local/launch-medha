#!/bin/sh
# MEDHA IDE launcher (strict snap).
# WHAT: run the IDE with the snap's own Python + Qt, and make the bundled compilers the ones
#       MEDHA finds on PATH (toolchains.py checks PATH after Settings / bundled folders).
# WHERE: $SNAP/bin/python3 -> python -m medha -> medha/ in $SNAP/app.
ARCH_TRIPLET="$(uname -m)-linux-gnu"
export PYTHONPATH="$SNAP/app${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$SNAP/usr/lib/$ARCH_TRIPLET${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# WHY toolwrap first: gcc/g++ wrappers add --sysroot=$SNAP (see snap/local/toolwrap/gcc).
# WHY jdk/bin: bundled Temurin JDK 25 (javac + java).
export JAVA_HOME="$SNAP/jdk"
export PATH="$SNAP/toolwrap:$JAVA_HOME/bin:$SNAP/usr/bin:$SNAP/bin:$PATH"
# Open in the user's REAL home (strict snaps set $HOME to ~/snap/medha-ide/<rev>).
cd "${SNAP_REAL_HOME:-$HOME}" 2>/dev/null || cd "$HOME"
exec "$SNAP/bin/python3" -m medha "$@"
