#!/bin/sh
# MEDHA strict snap: cc -> gcc-13 with --sysroot=$SNAP
# WHY: inside the sandbox "/" is the core24 base, which has no compiler headers or crt files.
#      --sysroot makes gcc take headers/libs from the snap (staged by the 'compilers' part).
# FLOW: MEDHA runner / Turbo builder -> "cc" on PATH -> this script -> real gcc-13.
exec "$SNAP/usr/bin/gcc-13" --sysroot="$SNAP" "$@"
